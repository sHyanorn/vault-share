# Copy to .env. Docker Compose reads it automatically; for a local binary run
# export the variables, for example `set -a; . ./.env; set +a`.

# Public host name. Compose derives VAULT_BASE_URL from it and Caddy obtains a
# certificate for it: locally trusted for localhost, Let's Encrypt otherwise.
VAULT_DOMAIN=localhost

# Largest ciphertext accepted for one upload, in bytes (default 1 GiB).
VAULT_MAX_FILE_BYTES=1073741824

# debug, info, warn or error.
VAULT_LOG_LEVEL=info

# The settings below apply only when vaultd runs outside Docker.
VAULT_LISTEN_ADDR=:8080
VAULT_BASE_URL=https://localhost
VAULT_DATA_DIR=./data
# Built frontend to serve; leave unset to run the API only.
#VAULT_WEB_DIR=./web/dist
# Addresses or CIDRs of reverse proxies whose X-Forwarded-For is trusted.
# Leave unset when clients connect directly.
#VAULT_TRUSTED_PROXIES=10.0.0.0/8
