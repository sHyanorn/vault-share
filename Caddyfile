# Caddy terminates TLS and proxies everything to vaultd. Certificates are
# automatic: a locally trusted one for localhost, Let's Encrypt for real hosts.
# The ports are internal (see Dockerfile.caddy); clients still use 80 and 443.
{
	http_port 8080
	https_port 8443
	admin off
	# Clients that send no SNI (Java for single-label hosts) still get the site's certificate.
	default_sni {$VAULT_DOMAIN:localhost}
	# The container's filesystem is read-only; nothing to install the local root into.
	skip_install_trust
	# A request that fails here, such as a 502 while vaultd is down, goes to
	# the error log with its URI; download tokens travel in the query (F68).
	log default {
		format filter {
			request>uri query {
				replace token REDACTED
			}
		}
	}
	servers {
		# HTTP/3 would advertise the internal port; TCP only.
		protocols h1 h2
		# vaultd's own limits. Bodies and responses get no fixed deadline here:
		# vaultd gives each transfer one that grows with the file size.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# Declared so the HTTP server is built from this file and takes the timeouts
# above; the redirect Caddy adds on its own would get the defaults.
http://{$VAULT_DOMAIN:localhost} {
	redir https://{host}{uri} 308
}

{$VAULT_DOMAIN:localhost} {
	reverse_proxy vaultd:8080
}
