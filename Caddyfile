# Caddy terminates TLS and proxies everything to vaultd. Certificates are
# automatic: a locally trusted one for localhost, Let's Encrypt for real hosts.
# The ports are internal (see Dockerfile.caddy); clients still use 80 and 443.
{
	http_port 8080
	https_port 8443
	admin off
	# Clients that send no SNI (Java for single-label hosts) still get the site's certificate.
	default_sni {$VAULT_DOMAIN:localhost}
	# The container's filesystem is read-only; nothing to install the local root into.
	skip_install_trust
	# HTTP/3 would advertise the internal port; TCP only.
	servers {
		protocols h1 h2
	}
}

{$VAULT_DOMAIN:localhost} {
	reverse_proxy vaultd:8080
}
